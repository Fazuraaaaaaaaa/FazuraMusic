let player;
let currentPlaylist = [];
let currentSongIndex = -1;
let progressInterval;
let isPlaying = false;

// Fungsi ini akan dipanggil otomatis oleh script YouTube IFrame API saat siap
function onYouTubeIframeAPIReady() {
    player = new YT.Player('youtube-player', {
        height: '80',
        width: '120',
        playerVars: {
            'playsinline': 1,
            'controls': 0, // Tanpa kontrol default youtube
            'disablekb': 1,
            'fs': 0,
            'rel': 0
        },
        events: {
            'onReady': onPlayerReady,
            'onStateChange': onPlayerStateChange,
            'onError': onPlayerError
        }
    });
}

function onPlayerError(event) {
    console.error("YouTube Player Error", event.data);
    let errMsg = "Video gagal dimuat.";
    // Error 150 atau 101 berarti "Embed Disabled" oleh pemilik hak cipta
    if (event.data === 150 || event.data === 101) {
        errMsg = "Pemilik hak cipta tidak mengizinkan lagu ini diputar di luar YouTube (Embed Disabled). Coba lagu lain!";
    }
    alert("Maaf: " + errMsg);
    document.getElementById('play-pause-btn').innerText = '▶️';
    stopProgressBar();
}

function onPlayerReady(event) {
    document.getElementById('play-pause-btn').disabled = false;
    
    // Set volume awal
    let vol = document.getElementById('volume-bar').value;
    player.setVolume(vol);
}

function onPlayerStateChange(event) {
    const playBtn = document.getElementById('play-pause-btn');
    
    // PLAYING = 1, PAUSED = 2, ENDED = 0, BUFFERING = 3
    if (event.data == YT.PlayerState.PLAYING) {
        isPlaying = true;
        playBtn.innerText = '⏸️'; // Icon Pause
        startProgressBar();
    } 
    else if (event.data == YT.PlayerState.PAUSED) {
        isPlaying = false;
        playBtn.innerText = '▶️'; // Icon Play
        stopProgressBar();
    }
    else if (event.data == YT.PlayerState.BUFFERING) {
        playBtn.innerText = '⏳';
    }
    else if (event.data == YT.PlayerState.ENDED) {
        playNext(); // Otomatis putar lagu selanjutnya
    }
}

// Logika Tombol Kontrol
document.getElementById('play-pause-btn').addEventListener('click', () => {
    if(!player || currentSongIndex === -1) return;
    if(isPlaying) {
        player.pauseVideo();
    } else {
        player.playVideo();
    }
});

document.getElementById('next-btn').addEventListener('click', playNext);
document.getElementById('prev-btn').addEventListener('click', playPrev);

document.getElementById('volume-bar').addEventListener('input', (e) => {
    if(player && player.setVolume) {
        player.setVolume(e.target.value);
    }
});

document.getElementById('progress-bar').addEventListener('input', (e) => {
    if(player && player.getDuration) {
        const duration = player.getDuration();
        const seekTo = (e.target.value / 100) * duration;
        player.seekTo(seekTo, true);
    }
});

function playNext() {
    if (currentSongIndex < currentPlaylist.length - 1) {
        playSong(currentSongIndex + 1);
    }
}

function playPrev() {
    if (currentSongIndex > 0) {
        playSong(currentSongIndex - 1);
    }
}

function startProgressBar() {
    progressInterval = setInterval(() => {
        if(player && player.getCurrentTime) {
            const currentTime = player.getCurrentTime();
            const duration = player.getDuration();
            
            document.getElementById('current-time').innerText = formatTime(currentTime);
            document.getElementById('total-time').innerText = formatTime(duration);
            
            const progressPercent = (currentTime / duration) * 100;
            document.getElementById('progress-bar').value = progressPercent;
        }
    }, 1000); // update tiap 1 detik
}

function stopProgressBar() {
    clearInterval(progressInterval);
}

function formatTime(seconds) {
    if (!seconds || isNaN(seconds)) return "0:00";
    seconds = Math.floor(seconds);
    const m = Math.floor(seconds / 60);
    const s = seconds % 60;
    return m + ":" + (s < 10 ? "0" : "") + s;
}

// ============================================
// LOGIKA FETCH DATA DARI PYTHON FLASK BACKEND
// ============================================
document.addEventListener('DOMContentLoaded', () => {
    // Saat halaman dimuat, langsung ambil data Trending (Charts)
    fetchCharts();

    document.getElementById('search-btn').addEventListener('click', () => {
        const query = document.getElementById('search-input').value;
        if(query) fetchSearch(query);
    });

    document.getElementById('search-input').addEventListener('keypress', (e) => {
        if(e.key === 'Enter') {
            const query = e.target.value;
            if(query) fetchSearch(query);
        }
    });
});

function renderList(songs, title) {
    document.getElementById('list-title').innerText = title;
    const list = document.getElementById('song-list');
    list.innerHTML = '';
    
    // Mapping format data balasan ytmusicapi
    currentPlaylist = songs.map(song => {
        const videoId = song.videoId;
        const title = song.title;
        
        let artistName = "Unknown Artist";
        if(song.artists && song.artists.length > 0) {
            artistName = song.artists.map(a => a.name).join(', ');
        }
        
        let thumbUrl = "https://via.placeholder.com/60";
        if (song.thumbnails && song.thumbnails.length > 0) {
            thumbUrl = song.thumbnails[song.thumbnails.length - 1].url;
        }

        return { videoId, title, artistName, thumbUrl };
    }).filter(s => s.videoId); // Pastikan hanya memasukkan data yang memiliki videoId (bisa diputar)

    if(currentPlaylist.length === 0) {
        list.innerHTML = '<p style="color:red">Lagu tidak ditemukan. Coba kata kunci lain.</p>';
        return;
    }

    currentPlaylist.forEach((song, index) => {
        const li = document.createElement('li');
        li.innerHTML = `
            <img src="${song.thumbUrl}" alt="art">
            <div class="song-details">
                <h4>${song.title}</h4>
                <p>${song.artistName}</p>
            </div>
        `;
        li.onclick = () => playSong(index);
        list.appendChild(li);
    });
}

function playSong(index) {
    currentSongIndex = index;
    const song = currentPlaylist[index];
    
    // Update Tampilan (UI) Bar Bawah
    document.getElementById('track-name').innerText = song.title;
    document.getElementById('artist-name').innerText = song.artistName;
    document.getElementById('track-art').src = song.thumbUrl;
    
    document.getElementById('progress-bar').disabled = false;
    document.getElementById('progress-bar').value = 0;
    document.getElementById('current-time').innerText = "0:00";

    // Minta iFrame Player untuk memainkan video berdasarkan ID-nya
    if(player && player.loadVideoById) {
        player.loadVideoById(song.videoId);
    }
}

async function fetchCharts() {
    const loading = document.getElementById('loading');
    loading.style.display = 'block';
    document.getElementById('song-list').innerHTML = '';
    
    try {
        const res = await fetch('/api/charts');
        const data = await res.json();
        loading.style.display = 'none';
        renderList(data, '🔥 Trending Music (Indonesia)');
    } catch(e) {
        loading.style.display = 'none';
        console.error("Error fetching charts", e);
    }
}

async function fetchSearch(query) {
    const loading = document.getElementById('loading');
    loading.style.display = 'block';
    document.getElementById('song-list').innerHTML = '';
    
    try {
        const res = await fetch(`/api/search?q=${encodeURIComponent(query)}`);
        const data = await res.json();
        loading.style.display = 'none';
        renderList(data, `🔎 Hasil Pencarian: "${query}"`);
    } catch(e) {
        loading.style.display = 'none';
        console.error("Error searching", e);
    }
}
